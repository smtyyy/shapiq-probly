root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yaml,yml}]
indent_size = 2

[.github/workflows/*.{yaml,yml}]
indent_size = 4

[*.md]
# Two trailing spaces are a meaningful Markdown line break.
trim_trailing_whitespace = false

[*.bib]
# Keep the convention enforced by docs/format_bib.py.
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab
